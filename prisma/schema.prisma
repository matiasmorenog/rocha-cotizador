generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  /// bcrypt hash — initial seed is a 4-digit PIN; clients must set a real password.
  passwordHash       String   @map("pinHash")
  mustChangePassword Boolean  @default(true)
  discountPercent    Decimal  @default(0) @db.Decimal(5, 2)
  address            String?
  phone              String?
  email              String?
  notes              String?
  paymentTerms       String?
  deliveryHours      String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  quotes             Quote[]
}

model Product {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  rubro     String?
  basePrice Decimal  @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, code])
}

model Quote {
  id         String      @id @default(cuid())
  number     String      @unique
  status     QuoteStatus @default(SUBMITTED)
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  subtotal   Decimal     @db.Decimal(14, 2)
  total      Decimal     @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      QuoteItem[]

  @@index([customerId, createdAt])
  @@index([createdAt])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  productCode String
  productName String
  qty         Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  @@index([quoteId])
}

model QuoteSequence {
  id    Int @id @default(1)
  value Int @default(0)
}

/// Singleton app settings (id = 1). WhatsApp notify uses wa.me (no Business API).
model BusinessSettings {
  id                   Int    @id @default(1)
  /// Digits for wa.me (e.g. 5491166904442). Display forms are normalized on save.
  whatsappNotifyPhone  String @default("5491166904442")
  updatedAt            DateTime @updatedAt
}
