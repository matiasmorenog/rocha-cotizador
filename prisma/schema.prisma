generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Staff roles on User (email login). CUSTOMER is unused on User — clients live in Customer.
enum UserRole {
  ADMIN
  QUOTES
  STOCK
  /// Platform owner (developer). Singleton — bootstrap via PLATFORM_OWNER_EMAIL.
  SUPERUSER
  CUSTOMER
}

/// Opt-in product modules per customer / branch.
enum CustomerModule {
  MERMAS
  CONSUMABLES
  ACTIVOS
}

/// Stock recount classification on Product (independent of rubro).
enum ProductStockKind {
  MERMA
  CONSUMABLE
  LOCAL_ASSET
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
}

model User {
  id                        String             @id @default(cuid())
  email                     String             @unique
  name                      String?
  passwordHash              String?
  role                      UserRole           @default(ADMIN)
  /// Staff capability: cotización (productos, listas, cotizaciones). ADMIN ignores flags.
  canQuotes                 Boolean            @default(false)
  /// Staff capability: stock (mermas, consumibles). ADMIN ignores flags.
  canStock                  Boolean            @default(false)
  active                    Boolean            @default(true)
  /// Legacy sync flag — prefer role SUPERUSER. Kept for schema/health probes.
  isSuperuser               Boolean            @default(false)
  /// Account-level: in-app toast/poll while admin is open (default on).
  inAppNotificationsEnabled Boolean            @default(true)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  pushSubscriptions         PushSubscription[]
}

/// Browser Web Push subscription for admin quote notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// In-app admin alerts (safe path — no OS notification required).
/// Written when a customer creates a quote; polled while /admin is open.
model AdminInboxItem {
  id        String   @id @default(cuid())
  title     String
  body      String
  url       String
  quoteId   String?
  /// "quote" | "test"
  kind      String   @default("quote")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Customer {
  id                 String                 @id @default(cuid())
  code               String                 @unique
  name               String
  /// Admin-only contact/clarification (e.g. person name); not shown to customers.
  nameNote           String?
  /// bcrypt hash — initial seed is a 4-digit PIN; clients must set a real password.
  passwordHash       String                 @map("pinHash")
  mustChangePassword Boolean                @default(true)
  /// Prefer the isBase PriceList id; null still resolves as Precio base.
  priceListId        String?
  priceList          PriceList?             @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  address            String?
  phone              String?
  email              String?
  notes              String?
  paymentTerms       String?
  deliveryHours      String?
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  quotes             Quote[]
  moduleAccess       CustomerModuleAccess[]
  mermaEntries       MermaEntry[]
  consumableCounts   ConsumableCount[]
  localAssetCounts   LocalAssetCount[]

  @@index([priceListId])
}

model CustomerModuleAccess {
  id         String         @id @default(cuid())
  customerId String
  module     CustomerModule
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, module])
  @@index([module, enabled])
}

model Product {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  rubro           String?
  basePrice       Decimal         @db.Decimal(12, 2)
  /// When true, customer may order by unit count (price TBD after weigh) or by kg.
  /// When false, customer orders by fixed-price quantity (unidades).
  allowsUnitOrder Boolean         @default(false)
  /// Shown in catalog when combined with stockKind quote rules.
  available       Boolean         @default(true)
  /// Stock module type; null = not classified for stock (sale-only or legacy).
  stockKind       ProductStockKind?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  priceListItems  PriceListItem[]
  mermaLines            MermaLine[]
  consumableCountLines  ConsumableCountLine[]
  localAssetCountLines  LocalAssetCountLine[]

  @@index([available, code])
  @@index([stockKind])
}

/// Named price list with fixed unit prices (Excel ROUND).
/// Exactly one row should have isBase=true ("Precio base", excelKey "5") — enforced in app.
model PriceList {
  id        String          @id @default(cuid())
  name      String
  /// Excel "Lista de Precio" key (e.g. "5", "6") for re-import; optional for manual lists.
  excelKey  String?         @unique
  /// True only for the Precio base list (synced with Product.basePrice).
  isBase    Boolean         @default(false)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     PriceListItem[]
  customers Customer[]

  @@index([isBase])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice   Decimal   @db.Decimal(12, 2)
  updatedAt   DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([priceListId])
  @@index([productId])
}

model Quote {
  id           String      @id @default(cuid())
  number       String      @unique
  status       QuoteStatus @default(SUBMITTED)
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  subtotal     Decimal     @db.Decimal(14, 2)
  total        Decimal     @db.Decimal(14, 2)
  notes        String?
  /// Requested delivery / fulfillment calendar day (Argentina). Nullable for legacy rows.
  deliveryDate DateTime?   @db.Date
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        QuoteItem[]

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([deliveryDate])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  productCode String
  productName String
  qty         Decimal @db.Decimal(12, 3)
  /// True when qty is unit count (not kg); unitPrice/lineTotal must be 0.
  orderByUnit Boolean @default(false)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  @@index([quoteId])
}

model QuoteSequence {
  id    Int @id @default(1)
  value Int @default(0)
}

/// Singleton app settings (id = 1). WhatsApp notify uses wa.me (no Business API).
model BusinessSettings {
  id                  Int      @id @default(1)
  /// Digits for wa.me (e.g. 5491166904442). Display forms are normalized on save.
  whatsappNotifyPhone String   @default("5491166904442")
  updatedAt           DateTime @updatedAt
}

/// End-of-day waste / merma per branch (customer with MERMAS module).
model MermaEntry {
  id           String      @id @default(cuid())
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Calendar day of the merma close (Argentina).
  entryDate    DateTime    @db.Date
  notes        String?
  submittedBy  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  lines        MermaLine[]

  @@unique([customerId, entryDate])
  @@index([entryDate, createdAt])
}

model MermaLine {
  id        String     @id @default(cuid())
  entryId   String
  entry     MermaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit      String     @default("unid.")
  qty       Decimal    @db.Decimal(12, 3)

  @@unique([entryId, productId])
  @@index([productId])
}

/// Consumables inventory recount per customer / day.
model ConsumableCount {
  id          String                @id @default(cuid())
  customerId  String
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entryDate   DateTime              @db.Date
  notes       String?
  submittedBy String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  lines       ConsumableCountLine[]

  @@unique([customerId, entryDate])
  @@index([entryDate, createdAt])
}

model ConsumableCountLine {
  id        String          @id @default(cuid())
  countId   String
  count     ConsumableCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit      String          @default("unid.")
  qty       Decimal         @db.Decimal(12, 3)

  @@unique([countId, productId])
  @@index([productId])
}

/// Local assets (carts, trays, etc.) per customer — flexible entry date.
model LocalAssetCount {
  id          String                @id @default(cuid())
  customerId  String
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entryDate   DateTime              @db.Date
  notes       String?
  submittedBy String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  lines       LocalAssetCountLine[]

  @@unique([customerId, entryDate])
  @@index([entryDate, createdAt])
}

model LocalAssetCountLine {
  id        String          @id @default(cuid())
  countId   String
  count     LocalAssetCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit      String          @default("unid.")
  qty       Decimal         @db.Decimal(12, 3)

  @@unique([countId, productId])
  @@index([productId])
}

/// Monthly SaaS fee Rocha pays the developer. Owner-only writes.
model SubscriptionPayment {
  id          String    @id @default(cuid())
  periodYear  Int
  periodMonth Int
  amountUsd   Decimal   @default(100) @db.Decimal(10, 2)
  amountArs   Decimal?  @db.Decimal(12, 2)
  /// ARS per 1 USD.
  fxRate      Decimal?  @db.Decimal(12, 4)
  paidAt      DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([periodYear, periodMonth])
}
