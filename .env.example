# Local + Preview: Neon branch **development** (never `main` / production).
# Production (Vercel Production): Neon branch **main** only — never seed against it.
#
# Neon endpoints (rocha-cotizador, us-west-2):
#   development: ep-noisy-darkness-a6ms81wq
#   main/prod:   ep-cool-mud-a6k5vosf
#
# Prefer non-pooled URL locally so `prisma db push` / seed work.
# Vercel: pooled URL with pgbouncer=true&connection_limit=1 (see DEPLOY.md).
# Optional on Vercel if connects flake: &connect_timeout=15
DATABASE_URL="postgresql://USER:PASSWORD@ep-noisy-darkness-a6ms81wq.us-west-2.aws.neon.tech/neondb?sslmode=require"
# Neon Vercel Preview (pooled, development branch):
# DATABASE_URL="postgresql://USER:PASSWORD@ep-noisy-darkness-a6ms81wq-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# Neon Vercel Production (pooled, main) — app only, NEVER seed:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-cool-mud-a6k5vosf-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
# GitHub Actions schema gate: DATABASE_URL_PRODUCTION = Neon main DIRECT (no -pooler).
# Local Postgres alternative:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rocha_cotizador?schema=public"

# Seed / mutation scripts refuse Neon main. Pick one:
SEED_TARGET=development
# ALLOW_DESTRUCTIVE_DB=1   # only for non-prod (e.g. local Postgres); still refuses main host

# Optional overrides if Neon endpoint ids change (comma-separated host substrings):
# NEON_PROD_HOST=ep-cool-mud-a6k5vosf
# NEON_DEV_HOST=ep-noisy-darkness-a6ms81wq
# PRODUCTION_DATABASE_HOST=ep-cool-mud-a6k5vosf

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Production: https://rocha-cotizador.vercel.app
# Optional: shared secret for POST /api/revalidate after seed / wipe / DB scripts.
# Scripts call scripts/revalidate-app-cache.ts (warn if missing; do not abort).
# Expires ALL Data Cache tags (products, price-lists, customers, admin-dashboard).
# REVALIDATE_SECRET="generate-with-openssl-rand-base64-32"
# Optional seed-only password override (default in prisma/seed.ts: admin1234).
# Admin email is hardcoded in seed as admin@rocha.com — not an env var.
# ADMIN_PASSWORD="admin1234"

# Web Push — admin notifications for new customer quotes
# Generate once: npx web-push generate-vapid-keys
# Load same trio on Vercel Production + Preview + Development (never commit private key).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://rocha-cotizador.vercel.app"

# Platform owner (developer). Comma-separated emails. Bootstraps User.isSuperuser
# on login / scripts/bootstrap-superuser.ts — not a second auth system.
# Missing: owner route 404; Rocha Configuración still shows pending for current month.
# PLATFORM_OWNER_EMAIL="you@example.com"

# Demo login — local + Vercel Preview / rocha-cotizador-dev only. NEVER Production.
# UI: collapsible "Inicio demo" on /entrar and login pages. One-click via NextAuth demo provider.
# Seed upserts personas (customers 900–906 PIN 1234, staff demo-*@rocha.dev).
# DEMO_LOGIN_ENABLED=1
# NEXT_PUBLIC_DEMO_LOGIN_ENABLED=1
