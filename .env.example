# Local Postgres or Neon. On Neon: DATABASE_URL = pooled (-pooler), DIRECT_URL = non-pooled.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rocha_cotizador?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/rocha_cotizador?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Production: https://rocha-cotizador.vercel.app
ADMIN_EMAIL="admin@rocha.local"
ADMIN_PASSWORD="admin1234"
