# Local: prefer non-pooled Neon URL (or local Postgres) so `prisma db push` / seed work.
# Vercel: pooled URL with pgbouncer=true&connection_limit=1 (see DEPLOY.md).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rocha_cotizador?schema=public"
# Neon local (direct, no -pooler) example:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Neon Vercel (pooled) example:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# Production: https://rocha-cotizador.vercel.app
# Optional seed-only password override (default in prisma/seed.ts: admin1234).
# Admin email is hardcoded in seed as admin@rocha.com — not an env var.
# ADMIN_PASSWORD="admin1234"
